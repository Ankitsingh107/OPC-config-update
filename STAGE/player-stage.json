{
  "autoPreview": {
    "enabled": true,
    "previewImageShowTime": 3
  },
  "channelZappingConfig": {
    "keypadInputTimeout": 500,
    "maxInputDigits": 3
  },
  "drmCertificateInfo": {
    "certificateUrl": "https://license.ctrp.astro.com.my/licenseServer/streaming/v1/astro/getcertificate?applicationId=live",
    "fairPlayLicenseUrl": "https://license.ctrp.astro.com.my/licenseServer/streaming/v1/astro/getckc"
  },
  "lowNetworkConfig": {
    "averageNumberOfChunks": 5,
    "enableSlowNetworkFeature": true,
    "networkBandwidthThreshold": 600,
    "networkThresholdTimeout": 30,
    "safariNetworkIntervalThreshold": 5,
    "slowNetworkToastThreshold": 10
  },
  "player": {
    "bufferTime": {
      "hd": {
        "cdvr": "30",
        "live": "18",
        "restart": "18",
        "vod": "30"
      },
      "uhd": {
        "live": "",
        "vod": ""
      }
    },
    "initialBitrate": {
      "value": ""
    },
    "restartTvGuardTime": {
      "value": ""
    },
    "videoPreview": {
      "previewDelay": ""
    }
  },
  "thumbnailInterval": "",
  "videoSnippetRule": {
    "linearEvent": [],
    "vodAndCdvr": [
      {
        "condition": {
          "genre": [
            "Sports",
            "News"
          ],
          "contentDuration": {
            "operator": ">",
            "value": "0:00"
          }
        },
        "preview": {
          "begin": "0:00",
          "duration": "1:00"
        }
      },
      {
        "condition": {
          "contentDuration": {
            "operator": "<",
            "value": "30:00"
          }
        },
        "preview": {
          "begin": "20%",
          "duration": "1:00"
        }
      },
      {
        "condition": {
          "contentDuration": {
            "operator": ">",
            "value": "30:00"
          }
        },
        "preview": {
          "begin": "10:00",
          "duration": "1:00"
        }
      }
    ]
  }
}
